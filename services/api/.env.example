DATABASE_URL=postgres://dailog:dailog@localhost:5432/dailog
# M5 迁移后移除（better-auth 自托管，不再依赖 Supabase）
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/jwks
BETTER_AUTH_SECRET= # M5 迁移后启用（better-auth 会话密钥）
PORT=8787
APP_ORIGINS= # 逗号分隔 Origin 白名单（开发: https://app.candelbot.app,http://localhost:5173；生产: https://app.dailog.fm）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
FISH_API_KEY=
FISH_PROXY_URL=
STORAGE_DRIVER=fs
STORAGE_DIR=./data
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
# R2 出口代理（大陆网络直连 r2 握手失败；socks5://127.0.0.1:1081；线上海外部署留空）
R2_PROXY_URL=

# 计划4 追加：
DEEPSEEK_API_KEY=
FISH_API_KEY=
FISH_PROXY_URL=socks5://127.0.0.1:1081
FISH_GUEST_REFERENCE_ID=
STORAGE_DRIVER=fs
STORAGE_DIR=./data
ASSETS_DIR=assets/audio

# 邮箱验证（计划7：注册即发送验证邮件；KEY 留空则跳过发送，功能降级为无验证）
RESEND_API_KEY=
EMAIL_FROM=dailog <no-reply@dailog.fm>

# 管理端点管理员白名单（逗号分隔邮箱；空 = 无管理员，/api/admin/* 一律 403）
ADMIN_EMAILS=
# 分享页采集服务地址（Railway 同 project 内网域名或公网 URL）
IMPORTER_URL=
# importer 服务鉴权 token（与 importer 服务的 IMPORTER_TOKEN 一致）
IMPORTER_TOKEN=
