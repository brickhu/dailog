{
  "version": 6,
  "note": "扩展采集 fallback 规则（jsDelivr 托管：https://cdn.jsdelivr.net/gh/brickhu/dailog@dev/collect-rules.json）。v6：deepseek DOM 改版校准（2026-08-07 真实采样）——data-message-author-role 已移除，消息容器 div.ds-message（user/assistant 共用），assistant 内容语义类 ds-assistant-message-main-content，user 内容为 ds-message 直接子 div；解析器对 user 容器嵌套 assistant 内容的判定同步（parseByRule 增强）。v5：deepseek URL 改版 /a/chat/s/{uuid}。v4：URL 规则数据化 + 平台访问预热。claude 已实测校准（div[role='article'] + data-testid='user-message' + div.font-claude-response > .standard-markdown）；chatgpt 沿用实测；doubao/gemini/kimi/tongyi 待实测。",
  "platforms": {
    "claude": {
      "url": {
        "host": "claude.ai",
        "conversationPath": "/chat/",
        "conversationIdPattern": "/chat/([a-f0-9-]+)"
      },
      "messageSelector": "div[role='article']",
      "userSelector": "[data-testid='user-message']",
      "assistantSelector": "div.font-claude-response",
      "contentSelector": ".standard-markdown"
    },
    "deepseek": {
      "url": {
        "host": "chat.deepseek.com",
        "conversationPath": "/a/chat/",
        "conversationIdPattern": "/a/chat/s/([^/?#]+)"
      },
      "userSelector": "div.ds-message",
      "assistantSelector": ".ds-assistant-message-main-content",
      "scrollContainer": ".ds-scroll-area"
    },
    "chatgpt": {
      "url": {
        "host": "chatgpt.com",
        "conversationPath": "/c/"
      },
      "userSelector": "[data-message-author-role='user']",
      "assistantSelector": "[data-message-author-role='assistant']",
      "contentSelector": ".markdown"
    },
    "doubao": {
      "url": {
        "host": "www.doubao.com",
        "conversationPath": "/chat/"
      },
      "userSelector": "[data-message-author-role='user']",
      "assistantSelector": "[data-message-author-role='assistant']"
    },
    "gemini": {
      "url": {
        "host": "gemini.google.com",
        "conversationPath": "/app/"
      }
    },
    "kimi": {
      "url": {
        "host": "kimi.moonshot.cn",
        "conversationPath": "/chat/"
      }
    },
    "tongyi": {
      "url": {
        "host": "www.tongyi.com",
        "conversationPath": "/"
      }
    }
  }
}
