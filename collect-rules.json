{
  "version": 7,
  "note": "扩展采集 fallback 规则（jsDelivr 托管：https://cdn.jsdelivr.net/gh/brickhu/dailog@dev/collect-rules.json）。v7：URL 判定通用化——对话页判定改为 URL 启发式（末端 ID 段）+ DOM 对话框兜底，废弃按平台维护的 conversationPath（deepseek 两次改版教训：/chat/ → /a/chat/s/，精确规则全失配）；会话 id 统一取路径末端段，废弃 conversationIdPattern；规则仅保留 host（域名分发）+ 选择器。deepseek 已实测校准（div.ds-message 容器 + .ds-assistant-message-main-content）；claude 已实测校准（div[role='article'] + data-testid='user-message' + div.font-claude-response > .standard-markdown）；chatgpt 沿用实测；doubao/gemini/kimi/tongyi 待实测。",
  "platforms": {
    "claude": {
      "url": {
        "host": "claude.ai"
      },
      "messageSelector": "div[role='article']",
      "userSelector": "[data-testid='user-message']",
      "assistantSelector": "div.font-claude-response",
      "contentSelector": ".standard-markdown"
    },
    "deepseek": {
      "url": {
        "host": "chat.deepseek.com"
      },
      "userSelector": "div.ds-message",
      "assistantSelector": ".ds-assistant-message-main-content",
      "scrollContainer": ".ds-scroll-area"
    },
    "chatgpt": {
      "url": {
        "host": "chatgpt.com"
      },
      "userSelector": "[data-message-author-role='user']",
      "assistantSelector": "[data-message-author-role='assistant']",
      "contentSelector": ".markdown"
    },
    "doubao": {
      "url": {
        "host": "www.doubao.com"
      },
      "userSelector": "[data-message-author-role='user']",
      "assistantSelector": "[data-message-author-role='assistant']"
    },
    "gemini": {
      "url": {
        "host": "gemini.google.com"
      }
    },
    "kimi": {
      "url": {
        "host": "kimi.moonshot.cn"
      }
    },
    "tongyi": {
      "url": {
        "host": "www.tongyi.com"
      }
    }
  }
}
