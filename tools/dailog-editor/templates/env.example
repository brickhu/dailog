# dailog 编辑本地 Agent 配置（复制为 .env 后填写；.env 被 gitignore，勿提交）
# 用法：cp .dailog-editor/.env.example .dailog-editor/.env && chmod 600 .dailog-editor/.env
#
# 认证：不需要在此配置账号密码——首次运行 pnpm editor login：
# 终端给出授权链接 → 浏览器打开登录（已登录略过）→ 页面显示配对码 → 复制回终端粘贴
# 配对成功后 token 缓存到 .dailog-editor/session.json（chmod 600，不落密码）。

# API 基址：本地 dev http://localhost:8787；生产 https://api.dailog.fm
API_BASE=http://localhost:8787

# ---- 本地 TTS 合成（pnpm editor tts 标准路径，直连 Fish Audio，不绕服务端）----
# Fish Audio API key（https://fish.audio 控制台创建）
FISH_API_KEY=

# Fish 出口代理（socks5；大陆网络直连不稳时配置，缺省直连）
FISH_PROXY_URL=socks5://127.0.0.1:1081

# ---- R2 采样直取（host/guest 声线音频下载，与 API 同 bucket）----
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=

# R2 出口代理（socks5；缺省 socks5://127.0.0.1:1081）
R2_PROXY_URL=socks5://127.0.0.1:1081

# Pexels（封面图库搜索；可选，不配则 skill 用其他方式做封面）
PEXELS_API_KEY=

# 本地资产目录（intro/outro 音频；可选，缺失时合成降级为只拼主对话）
ASSETS_DIR=
